<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1">Products</h1>
    <p class="text-muted mb-0">A quick overview of your inventory.</p>
  </div>
  <div class="text-end">
    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">
      <i class="bi bi-box-seam-fill me-1"></i>
      <%= pluralize(@products.count, "product") %>
    </span>
    <%= link_to "Add Product", "/products/new", class: "btn btn-success" %>
  </div>
</div>

<div class="card shadow-sm">
  <% if @products.any? %>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">S/N</th>
              <th scope="col">Name</th>
              <th scope="col">Price</th>
              <th scope="col">Quantity</th>
              <th scope="col">SKU</th>
              <th scope="col">Status</th>
              <th scope="col">Date Added</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @products.each_with_index do |product, index| %>
              <tr>
                <td class="text-muted"><%= index + 1 %></td>
                <td class="fw-semibold"><%= product.name %></td>
                <td><%= number_to_currency(product.price) %></td>
                <td><%= product.quantity %></td>
                <td><code><%= product.sku %></code></td>
                <td>
                  <% if product.instock %>
                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                      <i class="bi bi-check-circle-fill me-1"></i>
                      In stock
                    </span>
                  <% else %>
                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle">
                      <i class="bi bi-x-circle-fill me-1"></i>
                      Out of stock
                    </span>
                  <% end %>
                </td>
                <td><%= product.created_at.strftime("%B %d, %Y") %></td>
                <td>
                 <%= link_to "Edit", "#", class: "btn btn-primary disabled", role: "button" %>
                <%= link_to "Delete", "#", class: "btn btn-danger disabled", role: "button" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card-body text-center py-5">
      <i class="bi bi-box-seam display-4 text-muted mb-3"></i>
      <p class="text-muted mb-0">You don't have any products yet.</p>
    </div>
  <% end %>
  <div class="card-footer mt-4">
  <%= paginate @products %>
  </div>
</div>
